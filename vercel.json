{
  "version": 2,
  "framework": "php",
  "functions": {
    "public/**/*.php": {
      "runtime": "php:8.2"
    }
  },
  "builds": [
    {
      "src": "public/index.php",
      "use": "@vercelphp/php"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/public/index.php"
    }
  ],
  "env": {
    "DB_PATH": "/tmp/invoices.db"
  }
}
